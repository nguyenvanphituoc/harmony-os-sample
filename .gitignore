# Shape Up SDLC run workspace
.shapeup/
.shapeup-sdlc/

# Shape Up SDLC Tier C — per-member local config (templates *.example stay committed).
# The env file is SHAPEUP_-namespaced (filename + keys) so it never collides with, or gets
# confused with, this project's own .env / .env.local.
.claude/settings.local.json
.env.shapeup.local
!.env.shapeup.example
!.claude/settings.local.example.json

# Soak run evidence — the LOCAL tier of a harness run (ADR-0001): nested session streams,
# leg journals and verbose T0 logs, superseded by the next run and ~58MB on disk. Kept in the
# working tree deliberately, out of history deliberately. Nothing here is input to a build.
.soak-evidence/

# hvigor build cache — regenerated by every build, never input to one.
.hvigor/
